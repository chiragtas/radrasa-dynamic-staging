{%- comment -%} lookOn try-on app block: the merchant places it anywhere on the product page. {%- endcomment -%}
{%- render 'lookon-tryon', block: block, product: product, placement: 'manual' -%}

{% schema %}
{
  "name": "lookOn try-on",
  "target": "section",
  "stylesheet": "product-tryon.css",
  "javascript": "product-tryon.js",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Drag this block anywhere in the product information, e.g. just above or below the Add to cart button. Every line can also be edited in Shopify admin > Apps > lookOn > Texts; text changed there wins over these fields."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try it on"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add a front-facing photo to see this on you."
    },
    {
      "type": "textarea",
      "id": "photo_hint",
      "label": "Photo guidance",
      "default": "Use a clear, front-facing photo with your whole head and shoulders in view.",
      "info": "Leave as is to show guidance that fits each product (e.g. wrist for watches)."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Choose photo",
      "info": "Leave as is to name the product type, e.g. \"Choose photo to try on earrings\"."
    },
    {
      "type": "text",
      "id": "selfie_label",
      "label": "Selfie button text",
      "default": "Take selfie"
    },
    {
      "type": "textarea",
      "id": "consent_text",
      "label": "Consent text",
      "default": "This is a photo of me and I'm 18 or over. I understand it is sent to an AI service to make the preview and is not saved."
    },
    {
      "type": "textarea",
      "id": "privacy_text",
      "label": "Privacy notice",
      "default": "Previews are AI-made and approximate: colour, size and fit will differ a little from the real product."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "scan_color",
      "label": "Scanner color",
      "default": "#5ee1ff",
      "info": "The light that sweeps over the shopper's photo while the preview is made."
    },
    {
      "type": "text",
      "id": "api_url",
      "label": "Try-on server URL",
      "default": "https://radrasa-dynamic-staging.vercel.app",
      "info": "Only change this if you host your own Try-On server."
    }
  ]
}
{% endschema %}
