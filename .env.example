# ---------- 1. AI engine: pick ONE with TRYON_ENGINE (or set only one set of keys and leave it out) ----------
# TRYON_ENGINE=gemini        # best match to the real product; paid per preview
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_SIZE=1K       # 1K, 2K or 4K; larger costs more
#
# TRYON_ENGINE=cloudflare    # free daily allowance, smaller and softer results
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_MODEL=@cf/black-forest-labs/flux-2-klein-4b   # flux-2-klein-9b is sharper but uses far more of the free allowance
# CF_OUTPUT_MAX=768

# ---------- 2. Shopify app (needed for many stores; skip for a single store you control) ----------
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# APP_URL=https://YOUR-TRYON-SERVER.example.com
# SCOPES=read_products
# TOKEN_ENC_KEY=a-long-random-string      # encrypts stored store tokens (defaults to a key derived from SHOPIFY_API_SECRET)
# OPEN_SHOPS=0     # 0 = only stores that installed the app; 1 = any *.myshopify.com store (default when no Shopify app is set)
# ALLOWED_SHOPS=my-store.myshopify.com,other.myshopify.com

# ---------- Optional: recognise products from their photo when the name/type/tags cannot place them ----------
# VISION_CLASSIFY=1           # one small vision call per unrecognised product, then remembered
# VISION_ENGINE=gemini        # or cloudflare (default: gemini if GEMINI_API_KEY is set, else cloudflare)
# VISION_MODEL=               # default gemini-2.5-flash / @cf/llava-hf/llava-1.5-7b-hf

# Websites allowed to call the API from a browser. Not needed if ALLOWED_SHOPS is set and your store uses its myshopify.com address.
# If your storefront uses its own domain, list it (comma separated, no trailing slash):
# CORS_ORIGINS=https://radrasa.com,https://www.radrasa.com

# ---------- 3. Storage (stores, tokens, product catalogue) ----------
# Default: a JSON file at ./data/db.json (needs a server with a disk). On Vercel/serverless use MongoDB:
# MONGODB_URI=
# DATA_FILE=./data/db.json   # or "memory" for no persistence

# ---------- 4. Limits and admin ----------
# TRYON_RETRIES=1             # extra AI tries when a result is blank or unchanged (each costs one more AI call)
# RATE_PER_MINUTE=4           # previews per visitor IP per minute
# DAILY_CAP_PER_SHOP=200      # previews per store per day
# DAILY_CAP=2000              # previews per day across all stores (80 for Cloudflare's free tier)
# Free credits for new stores: set "Welcome credits" in the super admin (Credit logic). DEFAULT_TRYON_CREDITS is no longer used.
# BILLING=off                 # turn credits off completely (e.g. only your own store)
# ADMIN_SECRET=               # enables POST /admin/sync and GET /admin/catalog
# SUPER_ADMIN_EMAIL=owner@example.com
# SUPER_ADMIN_PASSWORD=use-a-long-unique-password
# PLATFORM_SESSION_SECRET=use-a-separate-random-secret-at-least-32-characters
# PORT=3000

# ---------- 5. Credits and payments ----------
# Pricing (merchant share %, price per try-on, top-up limits) and the Stripe / Razorpay / Shopify Billing keys are set
# in the super admin panel (/panel > Pricing & payments), not here. Keys are stored encrypted with TOKEN_ENC_KEY.
# Webhook URLs to register with the gateways:
#   Stripe:   $APP_URL/webhooks/stripe     (checkout.session.completed, checkout.session.expired)
#   Razorpay: $APP_URL/webhooks/razorpay   (order.paid, payment.failed)
#   Shopify:  app_purchases_one_time/update is subscribed in shopify-app/shopify.app.toml
